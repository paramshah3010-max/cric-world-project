# ---------------------------------------------------------------------------
# CRIC WORLD — Example environment variables
# Copy this file to server/.env and fill in real values.
# NEVER commit your real .env file (it is git-ignored).
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://cricworld:cricworld@localhost:5432/cricworld?schema=public"

# Secret used to sign JWT access tokens. Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-secret"

# How long an issued JWT stays valid.
JWT_EXPIRES_IN="7d"

# Port the Express API server listens on.
PORT=4000

# Comma-separated list of origins allowed by CORS (the Vite dev server).
CLIENT_ORIGIN="http://localhost:5173"
